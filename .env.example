# ─── بيانات اعتماد Gmail OAuth ───
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
CREDENTIALS_JSON_PATH=credentials.json
TOKEN_JSON_PATH=token.json
GMAIL_USER=me

# ─── قاعدة البيانات ───
# PostgreSQL (إنتاج):
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/complaints
# SQLite (تطوير محلي):
DATABASE_URL=sqlite:///./complaints.db

# ─── إعدادات الاستطلاع ───
POLL_INTERVAL_SECONDS=300

# ─── إعدادات التسميات ───
AUTO_REPLIED_LABEL=AUTO_REPLIED

# ─── حدود المعدل ───
MAX_REPLIES_PER_HOUR=50

# ─── قوائم النطاقات ───
# نطاقات مسموح بها (فارغ = الكل مسموح)
ALLOWED_DOMAINS=
# نطاقات محظورة (مفصولة بفاصلة)
DENIED_DOMAINS=

# ─── مستوى السجلات ───
LOG_LEVEL=INFO

# ─── Redis (اختياري للمستقبل) ───
REDIS_URL=
